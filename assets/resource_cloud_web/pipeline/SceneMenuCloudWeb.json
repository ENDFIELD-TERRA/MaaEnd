    "GrayCancelButton": {
        "desc": "CloudWeb：灰色取消按钮改为按文字识别，云端灰底与图标模板不匹配时仍可取消",
        "recognition": "Or",
        "any_of": [
            {
                "recognition": "OCR",
                "roi": [0, 360, 1280, 360],
                "expected": ["取消", "Cancel", "cancel"],
                "threshold": 0.8
            },
            {
                "recognition": "And",
                "all_of": ["GrayButtonBackground", "__GrayCancelButtonIcon"],
                "box_index": 1
            }
        ]
    },
    "TrialOfSwordmancyEnterTrialMenu": { "timeout": 60000 },
    "TrialOfSwordmancyEnterTrialMenu2": { "timeout": 60000 },
    // 队列里紧接 IntelArchive 等全屏菜单时，好友列表会挡住地区总览链；
    // 快速传送前先走通用入世界复位，再进事务总览。
    // 拍照模式/画面设置可能残留到下一个终端；切换终端前先回大世界再进菜单链
    "EnvironmentMonitoringGoToOutskirtsMonitoringTerminal": {
        "action": "Custom",
        "custom_action": "SubTask",
        "custom_action_param": { "sub": ["SceneAnyEnterWorld"] }
    },
    "EnvironmentMonitoringGoToMarkerStoneMonitoringTerminal": {
        "action": "Custom",
        "custom_action": "SubTask",
        "custom_action_param": { "sub": ["SceneAnyEnterWorld"] }
    },
    // 全屏菜单（档案/好友等）带关闭按钮；快速传送前点掉它们再严格入世界
    "CloudWebNormalizeStart": {
        "recognition": "DirectHit",
        "action": "DoNothing",
        "next": ["CloudWebCloseFullscreen", "CloudWebEnterWorld"]
    },
    "CloudWebCloseFullscreen": {
        "recognition": "And",
        "all_of": ["CloseButtonType1"],
        "action": "Click",
        "post_delay": 400,
        "max_hit": 6,
        "next": ["CloudWebCloseFullscreen", "CloudWebEnterWorld"]
    },
    "CloudWebEnterWorld": {
        "recognition": "DirectHit",
        "action": "DoNothing",
        "next": ["SceneAnyEnterWorld"]
    },
    "TrialOfSwordmancyQuickTeleportStart": {
        "custom_action_param": {
            "sub": [
                "CloudWebNormalizeStart",
                "SceneEnterMenuRegionalOverviewWulingTrialOfSwordmancy"
