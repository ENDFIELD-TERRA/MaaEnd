{
    "__SceneImageCheck": {
        "desc": "CloudWeb：原生画面检查会主动触发登出提示，不适用于云流；仅 CloudWeb 资源禁用",
        "enabled": false
    },
    "InMenuList": {
        "desc": "CloudWeb：菜单总列表（模板检测 + 右侧 OCR 兜底）",
        "recognition": "Or",
        "any_of": [
            {
                "recognition": "And",
                "all_of": [
                    "CheckMenuListText",
                    "CheckMenuListText2",
                    "CheckMenuListColor"
                ]
            },
            {
                "recognition": "OCR",
                "roi": [
                    1000,
                    120,
                    280,
                    200
                ],
                "expected": [
                    "Regional Development",
                    "Regional",
                    "Development",
                    "Operational Manual",
                    "Operational",
                    "Protocol Pass",
                    "Protocol",
                    "Friends",
                    "行动手册",
                    "行動手冊",
                    "地区建设",
                    "地區建設",
                    "地域建設",
                    "지역 건설"
                ]
            },
            {
                "recognition": "OCR",
                "roi": [
                    0,
                    120,
                    320,
                    400
                ],
                "expected": [
                    "Operators",
                    "Events",
                    "Headhunt",
                    "Acquisition",
                    "Center",
                    "干员",
                    "活动",
                    "寻访"
                ]
            }
        ]
    },
    "__ScenePrivateWorldEnterMenuRegionalDevelopment": {
        "desc": "CloudWeb：大世界或已打开的菜单列表都可进入地区建设（Escape 打开列表后原地识别）",
        "recognition": "Or",
        "any_of": [
            "InWorld",
            "InMenuList"
        ],
        "next": [
            "__ScenePrivateMenuListEnterMenuRegionalDevelopment",
            "[JumpBack]__ScenePrivateWorldEnterMenuList"
        ]
    },
    "__ScenePrivateWorldEnterMenuList": {
        "desc": "CloudWeb：用 Escape 打开菜单总列表（网页不接收 Alt+click）",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    -200,
                    0,
                    200,
                    200
                ],
                "template": [
                    "SceneManager/WorldMenu.png"
                ],
                "green_mask": true,
                "threshold": 0.65
            }
        },
        "pre_wait_freezes": {
            "time": 100,
            "timeout": 1000
        },
        "action": "ClickKey",
        "key": 27,
        "post_delay": 1500,
        "rate_limit": 0,
        "next": [
            "__SceneImageCheck",
            "__ScenePrivateAnyEnterMenuListSuccess"
        ]
    },
    "__ScenePrivateMenuListEnterWorld": {
        "desc": "CloudWeb：用 Escape 关闭菜单总列表；帝江号总控中枢也按 Escape 返回",
        "recognition": "Or",
        "any_of": [
            "InMenuList",
            "InDijiangControlNexus"
        ],
        "pre_wait_freezes": {
            "time": 100,
            "timeout": 1000
        },
        "action": "ClickKey",
        "key": 27,
        "post_delay": 1500,
        "rate_limit": 0,
        "next": [
            "[JumpBack]SceneNoticeRewardsUpgrade",
            "__ScenePrivateAnyEnterWorldSuccess"
        ]
    },
