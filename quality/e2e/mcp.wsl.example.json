{
  "mcpServers": {
    "e2e": {
      "command": "wsl.exe",
      "args": [
        "--distribution", "<reviewed-distribution>",
        "--cd", "<absolute-WSL-path-to-quality/e2e>",
        "--exec", "env",
        "E2E_TELEMETRY_DISABLED=1", "E2E_UPDATE_CHECK_DISABLED=1",
        "MAAEND_WEB_TARGET_URL=<reviewed-real-http-or-https-url>",
        "node", "node_modules/e2e/dist/cli/bin.js", "mcp",
        "--config", "e2e.config.ts", "--target", "web", "--headed", "--max-sessions", "1"
      ],
      "disabled": true,
      "trust": false,
      "timeout": 30000
    }
  }
}
