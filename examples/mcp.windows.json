{
  "mcpServers": {
    "playwright": {
      "command": "cmd",
      "args": [
        "/d",
        "/s",
        "/c",
        "npx",
        "-y",
        "@playwright/mcp@0.0.83",
        "--browser=chrome",
        "--isolated",
        "--no-webmcp"
      ],
      "disabled": true,
      "trust": false,
      "timeout": 30000
    },
    "chrome-devtools": {
      "command": "cmd",
      "args": [
        "/d",
        "/s",
        "/c",
        "npx",
        "-y",
        "chrome-devtools-mcp@1.11.0",
        "--isolated",
        "--no-usage-statistics",
        "--no-performance-crux"
      ],
      "env": {
        "CHROME_DEVTOOLS_MCP_NO_UPDATE_CHECKS": "1"
      },
      "disabled": true,
      "trust": false,
      "timeout": 30000
    }
  }
}
