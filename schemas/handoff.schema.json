{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private MaaEnd team handoff (application contract, not A2A protocol)",
  "type": "object",
  "required": ["schema_version", "message_id", "message_type", "sequence", "timestamp", "case_id", "task_id", "correlation_id", "generation", "from", "to", "repository", "baseline_head", "candidate_id", "scope", "dependencies", "completion_criteria", "status", "summary", "artifacts", "unverified"],
  "properties": {
    "schema_version": {"const": 1},
    "message_id": {"type": "string", "minLength": 1},
    "message_type": {"enum": ["assignment", "question", "finding", "handoff", "ack", "review_result", "verification_result", "cancel_request", "stop_receipt"]},
    "sequence": {"type": "integer", "minimum": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "case_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"},
    "task_id": {"type": "string", "minLength": 1},
    "correlation_id": {"type": "string", "minLength": 1},
    "generation": {"type": "integer", "minimum": 1},
    "from": {"type": "string", "minLength": 1},
    "to": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "pattern": "^[^/ ]+/[^/ ]+$"},
    "baseline_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate_id": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "scope": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "completion_criteria": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "budget": {"type": "object", "properties": {"command_timeout_seconds": {"type": "integer", "minimum": 1}, "max_active_workers": {"type": "integer", "minimum": 1}, "cost_authority": {"type": "string"}}, "additionalProperties": false},
    "status": {"enum": ["assigned", "running", "blocked", "needs_review", "passed", "failed", "cancel_requested", "stopped", "superseded"]},
    "summary": {"type": "string", "minLength": 1},
    "artifacts": {"type": "array", "items": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": false}},
    "unverified": {"type": "array", "items": {"type": "string"}},
    "supersedes": {"type": ["string", "null"]},
    "acknowledges": {"type": ["string", "null"]},
    "blocker_ids": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
