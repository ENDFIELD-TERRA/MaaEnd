{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private candidate-bound report; truth must be verified separately",
  "type": "object",
  "required": ["phase", "generation", "candidate_id", "author", "status", "summary", "artifacts"],
  "properties": {
    "phase": {"enum": ["analysis", "integration", "review", "validation"]},
    "generation": {"type": "integer", "minimum": 1},
    "candidate_id": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "author": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "status": {"enum": ["passed", "failed", "blocked", "not_run"]},
    "summary": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "artifacts": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1, "pattern": "\\S"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": false}}
  },
  "additionalProperties": false
}
