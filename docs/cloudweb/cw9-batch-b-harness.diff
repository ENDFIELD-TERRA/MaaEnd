+    fn http_get(port: u16, path: &str) -> Result<String, String> {
+        let mut stream = TcpStream::connect(("127.0.0.1", port))
+            .map_err(|error| format!("HTTP connect failed: {error}"))?;
+        stream
+            .set_read_timeout(Some(Duration::from_secs(2)))
+            .map_err(|error| format!("HTTP read timeout setup failed: {error}"))?;
+        stream
+            .set_write_timeout(Some(Duration::from_secs(2)))
+            .map_err(|error| format!("HTTP write timeout setup failed: {error}"))?;
+        write!(
+            stream,
+            "GET {path} HTTP/1.1\r\nHost: 127.0.0.1\r\nConnection: close\r\n\r\n"
+        )
+        .map_err(|error| format!("HTTP write failed: {error}"))?;
+        let mut response = String::new();
+        let mut buffer = [0u8; 4096];
+        loop {
+            match stream.read(&mut buffer) {
+                Ok(0) => break,
+                Ok(read) => response.push_str(&String::from_utf8_lossy(&buffer[..read])),
+                Err(error)
+                    if error.kind() == std::io::ErrorKind::WouldBlock
+                        || error.kind() == std::io::ErrorKind::TimedOut =>
+                {
+                    break;
+                }
+                Err(error) => return Err(format!("HTTP read failed: {error}")),
+            }
+        }
+        Ok(response)
+    }
