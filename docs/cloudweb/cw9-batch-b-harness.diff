+    #[test]
+    #[ignore = "launches a temporary local Chrome on 127.0.0.1:9230"]
+    fn batch_b_media_freeze_repeat_and_screenshot() {
+        let mut guard = ChromeGuard::launch().expect("chrome setup");
+        let outcome = catch_unwind(AssertUnwindSafe(|| -> Result<(), String> {
+            let mut actuator = connect_test(&guard)?;
+            let probe = wait_for_probe(&mut actuator, Duration::from_secs(5))?;
+            let before = probe.presented;
+            eprintln!("[cw9-b] media before={before}");
+
+            actuator.evaluate("document.getElementById('cwRealVideo').pause()")?;
+            std::thread::sleep(Duration::from_millis(1200));
+            let frozen = actuator.media_probe()?;
+            eprintln!("[cw9-b] frozen paused={} presented={}", frozen.paused, frozen.presented);
+            assert!(frozen.paused, "video must be paused for the freeze probe");
+            assert_eq!(
+                frozen.presented, before,
+                "paused video must not advance presented frames"
+            );
+
+            // The legacy screenshot path can still succeed while media is
+            // frozen; it must not be treated as fresh media progress.
+            let shot = actuator.frame_sample()?;
+            assert_eq!(
+                shot.media.presented, before,
+                "screenshot must not relabel frozen media as new progress"
+            );
+            // The page-side slot may be empty while paused; if it still
+            // returns frames, they must keep the same presented counter.
+            if let Some(first) = actuator.poll_cycle(Instant::now())?
+                && let Some(second) = actuator.poll_cycle(Instant::now())?
+            {
+                assert_eq!(
+                    first.media.presented, second.media.presented,
+                    "repeated frozen frames must keep the same presented counter"
+                );
+            }
+
+            actuator.evaluate("document.getElementById('cwRealVideo').play()")?;
+            let resumed = wait_for_probe_after(&mut actuator, before, Duration::from_secs(5))?;
+            eprintln!("[cw9-b] resumed presented={}", resumed.presented);
+            assert!(resumed.presented > before);
+            actuator.stop_media()?;
+            Ok(())
+        }));
+        match outcome {
+            Ok(result) => {
+                guard.shutdown();
+                result.expect("media freeze test");
+            }
+            Err(payload) => {
+                guard.shutdown();
+                resume_unwind(payload);
+            }
+        }
+    }
