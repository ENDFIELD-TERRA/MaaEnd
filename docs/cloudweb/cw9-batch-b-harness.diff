+    fn batch_b_page_reload_changes_doc_nonce() {
+        let mut guard = ChromeGuard::launch().expect("chrome setup");
+        let outcome = catch_unwind(AssertUnwindSafe(|| -> Result<(), String> {
+            let mut first = connect_test(&guard)?;
+            let before = wait_for_probe(&mut first, Duration::from_secs(5))?;
+            let first_nonce = before.doc_nonce.clone();
+            eprintln!("[cw9-b] reload before nonce={first_nonce}");
+
+            let _ = first.evaluate("location.reload()");
+            std::thread::sleep(Duration::from_millis(800));
+
+            let mut second = connect_test(&guard)?;
+            let after = wait_for_probe(&mut second, Duration::from_secs(5))?;
+            eprintln!("[cw9-b] reload after nonce={}", after.doc_nonce);
+            assert_ne!(
+                after.doc_nonce, first_nonce,
+                "page reload must produce a new document nonce"
+            );
+            assert!(after.presented > 0);
+            second.stop_media()?;
+            Ok(())
+        }));
+        match outcome {
+            Ok(result) => {
+                guard.shutdown();
+                result.expect("page reload test");
+            }
+            Err(payload) => {
+                guard.shutdown();
+                resume_unwind(payload);
+            }
+        }
+    }
