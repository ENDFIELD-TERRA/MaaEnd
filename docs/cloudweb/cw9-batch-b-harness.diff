+    fn connect_test(guard: &ChromeGuard) -> Result<CdpActuator, String> {
+        let deadline = Instant::now() + Duration::from_secs(20);
+        loop {
+            let mut candidate = CdpActuator::with_target_url(guard.port, guard.page_url.clone());
+            match candidate.connect() {
+                Ok(()) => {
+                    wait_for_page(&mut candidate, Duration::from_secs(10))?;
+                    return Ok(candidate);
+                }
+                Err(error) => {
+                    if Instant::now() >= deadline {
+                        return Err(format!(
+                            "CDP connect failed: {error}; chrome stderr: {}",
+                            read_snippet(&guard.stderr_log, 1200)
+                        ));
+                    }
+                    std::thread::sleep(Duration::from_millis(250));
+                }
+            }
+        }
+    }
+
+    fn wait_for_probe_after(
+        actuator: &mut CdpActuator,
+        after: u64,
+        timeout: Duration,
+    ) -> Result<MediaProbe, String> {
+        let deadline = Instant::now() + timeout;
+        loop {
+            match actuator.media_probe() {
+                Ok(probe) if probe.presented > after => return Ok(probe),
+                Ok(_) => {}
+                Err(error) => {
+                    if Instant::now() >= deadline {
+                        return Err(error);
+                    }
+                }
+            }
+            if Instant::now() >= deadline {
+                return Err(format!("rVFC progress did not advance beyond {after}"));
+            }
+            std::thread::sleep(Duration::from_millis(50));
+        }
+    }
